{
  "name": "test-prism-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "npm test -- --watch=false",
    "prettier:fix": "prettier --write .",
    "json-server": "node __mocks__/server.js"
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "bracketSpacing": true,
    "arrowParens": "avoid",
    "bracketSameLine": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@12.2.0",
  "dependencies": {
    "@angular/animations": "^22.2.2",
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/material": "^22.2.3",
    "@angular/platform-browser": "^22.2.2",
    "@angular/router": "^22.2.2",
    "chart.js": "^4.5.1",
    "humanize-duration": "^3.35.0",
    "ng2-charts": "^11.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@types/humanize-duration": "^3.27.4",
    "@vitest/browser-playwright": "^5.0.4",
    "jsdom": "^30.1.2",
    "json-server": "0.17.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
